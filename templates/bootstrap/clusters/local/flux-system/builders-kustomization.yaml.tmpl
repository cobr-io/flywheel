apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: flywheel-dev-loop
  namespace: flux-system
spec:
  # Mirror-sourced Flywheel content changes only on `flywheel up` (which
  # applies it directly via client-go in the bootstrap dance), so this poll
  # is a slow fallback, not the delivery path. Kept long deliberately: a
  # routine 10s reconcile flips Ready=Unknown for ~260ms each cycle, and any
  # dependent (client-builders) that evaluates dependsOn during that blink
  # eats a --requeue-dependency penalty. At 5m the blink is ~0.09% of the
  # time instead of ~2.6%, which is what removes the commit-to-pod outlier.
  interval: 5m
  prune: true
  sourceRef:
    kind: GitRepository
    name: flywheel
  path: ./manifests/dev-loop/overlays/local
  # SSA via Flux's default fieldManager so the bootstrap dance's
  # client-go apply (with fieldManager=flux-controller) hands over
  # cleanly.
  force: true
  # Rewrite the mirror's generic ghcr.io image refs to the resolved
  # refs `flywheel up` step 9 loaded into containerd (cfg.flywheel.images
  # overrides if set, else the published ghcr.io defaults at the pinned
  # version). These values are rendered fresh by `flywheel up` on every
  # invocation — this file is bootstrap-only, never committed to the
  # gitops repo, so .local edits flow through on the next `up`.
  # This is the dev-loop Kustomization's subset of the image rewrites — the
  # images whose Deployments live under this overlay. Which images belong here
  # vs. the client-builders Kustomization (and why) is decided by the
  # bootstrapImageOwners table in internal/cli/converge/bootstrap.go; this
  # template just ranges over the .DevLoopImages slice that table produces
  # (empty-safe — Go renders zero iterations).
  images:
{{- range .DevLoopImages }}
    - name: ghcr.io/cobr-io/{{ .Name }}
      newName: {{ .ImageName }}
      newTag: {{ .ImageTag }}
{{- end }}
  # Dev-loop memory limits. Both values come from converge.DevLoopLimitsFor —
  # the same producer the step-11a direct apply (ApplyDevLoop) reads — so the
  # two reconcile paths cannot land different limits on the same Deployment.
  # Rendered fresh on every `up`, so a flywheel.yaml change reconciles onto a
  # live cluster. The patch SHAPE here (Deployment name + container name) is
  # not checked by the renderer, so it is built through kustomize against the
  # real dev-loop tree in TestBuildersKustomization_PatchesBuildThroughKustomize;
  # a typo'd container name would otherwise inject an imageless container.
  #
  # git-server (cfg.git_server.memory_limit): git-upload-pack's pack
  # compression on a large monorepo would otherwise OOMKill the pod (issue #4).
  patches:
    - patch: |-
        apiVersion: apps/v1
        kind: Deployment
        metadata:
          name: git-server
          namespace: {{ .FlywheelNamespace }}
        spec:
          template:
            spec:
              containers:
                - name: git-server
                  resources:
                    limits:
                      memory: {{ .DevLoopLimits.GitServerMemory }}
    # git-auto-sync (cfg.git_auto_sync.memory_limit, default 256Mi). One shared
    # controller forks Git subprocesses for EVERY declared worktree into a
    # single cgroup, so this scales with worktree count; clients past ~10 can
    # raise it without carrying a client-owned patch that fights this
    # Kustomization.
    - patch: |-
        apiVersion: apps/v1
        kind: Deployment
        metadata:
          name: git-auto-sync
          namespace: {{ .FlywheelNamespace }}
        spec:
          template:
            spec:
              containers:
                - name: controller
                  resources:
                    limits:
                      memory: {{ .DevLoopLimits.GitAutoSyncMemory }}
